   "source": [
    "df_clean[\"InvoiceMonth\"] = pd.to_datetime(df_clean[\"InvoiceDate\"]).dt.month #create a month variable for the linear Regression\n",
    "# variables for the posttaxprofit\n",
    "df_clean[\"PostTaxProfitIfNexus\"] = df_clean[\"Profit\"]-df_clean[\"SalesTaxNoNexus\"] \n",
    "df_clean[\"ActualPostTaxProfit\"] = df_clean[\"Profit\"] - df_clean[\"SalesTaxOwed\"]\n",
    "# group dataframe for linear regression\n",
    "df_grouped = df_clean.groupby(by=[\"State\", \"InvoiceYear\", \"InvoiceMonth\"])[[\"ActualPostTaxProfit\", \"PostTaxProfitIfNexus\"]].sum().reset_index()\n",
    "df_grouped\n",
    "growth_trends = []\n",
    "\n",
    "# loop to predict the profit for all states\n",
    "for state in df_grouped[\"State\"].unique():\n",
    "    df_state = df_grouped[df_grouped[\"State\"] == state].copy()\n",
    "    # add the time index\n",
    "    df_state[\"time\"] = range(len(df_state))\n",
    "\n",
    "    if len(df_state) > 1:\n",
    "        #predict profit for the actual profit\n",
    "        model_actual = linear_model.LinearRegression()\n",
    "        model_actual.fit(df_state[[\"time\"]], df_state[[\"ActualPostTaxProfit\"]])\n",
    "        actual_post_tax_profit_growth = model_actual.coef_[0][0]\n",
    "        \n",
    "        #predict profit for the profitif there was a nexus\n",
    "        model_ifnexus = linear_model.LinearRegression()\n",
    "        model_ifnexus.fit(df_state[[\"time\"]], df_state[[\"PostTaxProfitIfNexus\"]])\n",
    "        post_tax_profit_ifnexus_growth = model_ifnexus.coef_[0][0]\n",
    "\n",
    "\n",
    "        # prediction for next month\n",
    "        next_month_index = len(df_state)\n",
    "        # save and append the predictions and the growth in the list\n",
    "        growth_trends.append({\n",
    "            \"State\": state,\n",
    "            \"ActualPostTaxProfit\": model_actual.predict([[next_month_index]])[0][0],\n",
    "            \"ActualPostTaxProfitGrowth\": actual_post_tax_profit_growth,\n",
    "            \"PostTaxProfitIfNexus\": model_ifnexus.predict([[next_month_index]])[0][0],\n",
    "            \"PostTaxProfitIfNexusGrowth\": post_tax_profit_ifnexus_growth\n",
    "        })\n",
    "# put list into dataframe\n",
    "df_trends = pd.DataFrame(growth_trends)\n",
    "df_trends\n",
    "\n",
    "#create a multiple bar diagram to compare the profits \n",
    "df_trends.plot(kind=\"bar\",x=\"State\", y=[\"ActualPostTaxProfit\", \"PostTaxProfitIfNexus\"])\n",
    "\n",
    "plt.xlabel(\"State\", fontsize =12)\n",
    "plt.ylabel(\"Profit after Tax\", fontsize = 12)\n",
    "plt.title(\"Comparison between the prognosted actual profit and the profit if there was a nexus\", fontsize =15)\n",
    "\n",
    "\n",
